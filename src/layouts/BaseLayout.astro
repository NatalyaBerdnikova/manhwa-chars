---
import '@fontsource/manrope/cyrillic-400.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/cyrillic-600.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/cyrillic-700.css';
import '@fontsource/manrope/latin-700.css';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { t } from '../i18n';
import { absoluteUrl, socialImage } from '../lib/seo';
import { abs } from '../lib/urls';
import ogDefault from '../assets/optimized/meta/og-default.webp';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  routePath: string;
  titleRu: string;
  titleEn: string;
  descriptionRu: string;
  descriptionEn: string;
  image?: ImageMetadata;
  imageAltRu: string;
  imageAltEn?: string;
  ogType?: 'website' | 'article' | 'profile';
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  routePath,
  titleRu,
  titleEn,
  descriptionRu,
  descriptionEn,
  image,
  imageAltRu,
  ogType = 'website',
  jsonLd = [],
  noindex = false,
} = Astro.props;

const canonical = abs(routePath);
const social = await socialImage(image ?? ogDefault);
const imageUrl = absoluteUrl(social.src, Astro.site);
const graph = jsonLd.length
  ? JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd }).replace(/</g, '\\u003c')
  : '';
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function () {
        var lang = 'ru';
        try {
          var stored = localStorage.getItem('lang');
          if (stored === 'ru' || stored === 'en') lang = stored;
          else {
            var list = navigator.languages || [navigator.language || ''];
            for (var i = 0; i < list.length; i++) {
              var code = String(list[i] || '').toLowerCase();
              if (code.indexOf('en') === 0) {
                lang = 'en';
                break;
              }
              if (code.indexOf('ru') === 0) {
                lang = 'ru';
                break;
              }
            }
          }
          var theme = localStorage.getItem('theme');
          if (theme === 'light' || theme === 'dark') {
            document.documentElement.setAttribute('data-theme', theme);
          }
        } catch (e) {}
        document.documentElement.lang = lang;
        document.documentElement.setAttribute('data-lang', lang);
        document.documentElement.classList.add('js');
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-ru={titleRu} data-en={titleEn}>{titleRu}</title>
    <script is:inline>
      (function () {
        var lang = document.documentElement.getAttribute('data-lang') === 'en' ? 'en' : 'ru';
        var title = document.querySelector('title');
        if (title) title.textContent = title.getAttribute('data-' + lang) || title.textContent;
      })();
    </script>
    <meta name="description" content={descriptionRu} data-ru={descriptionRu} data-en={descriptionEn} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={t('ru', 'meta.siteName')} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={titleRu} />
    <meta property="og:description" content={descriptionRu} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(social.attributes.width ?? 1200)} />
    <meta property="og:image:height" content={String(social.attributes.height ?? 630)} />
    <meta property="og:image:alt" content={imageAltRu} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titleRu} />
    <meta name="twitter:description" content={descriptionRu} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAltRu} />
    <meta name="theme-color" content="#f4f4f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    {graph && <script type="application/ld+json" set:html={graph} />}
  </head>
  <body>
    <a class="skip" href="#main"><span data-i18n="ru">{t('ru', 'skip')}</span><span data-i18n="en">{t('en', 'skip')}</span></a>
    <Header routePath={routePath} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        function lang() {
          return root.getAttribute('data-lang') === 'en' ? 'en' : 'ru';
        }
        function themeName() {
          var set = root.getAttribute('data-theme');
          if (set === 'light' || set === 'dark') return set;
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        function apply(next) {
          root.lang = next;
          root.setAttribute('data-lang', next);
          var title = document.querySelector('title');
          if (title) title.textContent = title.getAttribute('data-' + next) || title.textContent;
          var description = document.querySelector('meta[name="description"]');
          if (description) {
            description.setAttribute('content', description.getAttribute('data-' + next) || description.getAttribute('content') || '');
          }
          document.querySelectorAll('[data-ph-ru]').forEach(function (el) {
            el.placeholder = el.getAttribute('data-ph-' + next) || '';
          });
          document.querySelectorAll('[data-alt-ru]').forEach(function (el) {
            el.alt = el.getAttribute('data-alt-' + next) || '';
          });
          document.querySelectorAll('[data-aria-ru]').forEach(function (el) {
            el.setAttribute('aria-label', el.getAttribute('data-aria-' + next) || '');
          });
          document.querySelectorAll('option[data-ru]').forEach(function (el) {
            el.textContent = el.getAttribute('data-' + next) || el.textContent;
          });
          document.querySelectorAll('[data-set-lang]').forEach(function (el) {
            el.setAttribute('aria-pressed', el.getAttribute('data-set-lang') === next ? 'true' : 'false');
          });
          var themeBtn = document.getElementById('theme-toggle');
          if (themeBtn) {
            var mode = themeName();
            var key = (mode === 'dark' ? 'data-label-light-' : 'data-label-dark-') + next;
            themeBtn.setAttribute('aria-label', themeBtn.getAttribute(key) || '');
            themeBtn.setAttribute('aria-pressed', mode === 'dark' ? 'true' : 'false');
          }
        }
        apply(lang());
        document.addEventListener('click', function (event) {
          var target = event.target && event.target.closest ? event.target.closest('[data-set-lang]') : null;
          if (target) {
            var next = target.getAttribute('data-set-lang');
            if (next !== 'ru' && next !== 'en') return;
            try {
              localStorage.setItem('lang', next);
            } catch (e) {}
            apply(next);
            document.dispatchEvent(new CustomEvent('langchange', { detail: next }));
            return;
          }
          var themeBtn = event.target && event.target.closest ? event.target.closest('#theme-toggle') : null;
          if (!themeBtn) return;
          var nextTheme = themeName() === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', nextTheme);
          try {
            localStorage.setItem('theme', nextTheme);
          } catch (e) {}
          apply(lang());
        });
      })();
    </script>
  </body>
</html>
