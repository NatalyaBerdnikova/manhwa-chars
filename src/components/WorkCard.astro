---
import { pick, plural, t } from '../i18n';
import type { WorkEntry } from '../lib/catalog';
import { href } from '../lib/urls';
import CatalogImage from './CatalogImage.astro';
import BiText from './BiText.astro';

interface Props {
  work: WorkEntry;
  level?: 'h2' | 'h3';
  priority?: boolean;
  count?: number;
}

const { work, level = 'h2', priority = false, count } = Astro.props;
const title = pick(work.data.title, 'ru');
const titleEn = pick(work.data.title, 'en');
const page = href(`works/${work.id}`);
const Heading = level;
---

<article class="tile work-tile">
  <a class="tile-link" href={page}>
    <div class="tile-stage">
      {
        work.data.cover && (
          <div class="tile-shot">
            <CatalogImage
              src={work.data.cover}
              alt=""
              sizes="(min-width: 1100px) 240px, (min-width: 700px) 30vw, 46vw"
              priority={priority}
            />
          </div>
        )
      }
    </div>
    <Heading class="tile-name"><BiText ru={title.text} en={titleEn.text} /></Heading>
    <p class="tile-meta">
      {work.data.year ? <span class="badge">{work.data.year}</span> : null}
      {
        work.data.status && (
          <span class="badge accent">
            <BiText ru={t('ru', `status.${work.data.status}`)} en={t('en', `status.${work.data.status}`)} />
          </span>
        )
      }
      {
        typeof count === 'number' ? (
          <span class="badge">
            <span data-i18n="ru">{plural('ru', 'counts.characters', count)}</span>
            <span data-i18n="en">{plural('en', 'counts.characters', count)}</span>
          </span>
        ) : null
      }
    </p>
    {
      work.data.genres && work.data.genres.length > 0 && (
        <p class="tile-genres">{work.data.genres.join(' · ')}</p>
      )
    }
  </a>
</article>
