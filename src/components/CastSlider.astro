---
import { pick, t } from '../i18n';
import type { CharacterEntry } from '../lib/catalog';
import { href } from '../lib/urls';
import CatalogImage from './CatalogImage.astro';
import BiText from './BiText.astro';

interface Props {
  characters: CharacterEntry[];
  titleRu: string;
  titleEn: string;
}

const { characters, titleRu, titleEn } = Astro.props;
const total = String(characters.length).padStart(2, '0');
const labelRu = t('ru', 'slider.label', { title: titleRu });
const labelEn = t('en', 'slider.label', { title: titleEn });
const first = characters[0];
const firstName = first ? pick(first.data.name, 'ru').text : '';
---

<section
  class="cast-slider"
  data-cast-slider
  aria-roledescription="carousel"
  aria-label={labelRu}
  data-aria-ru={labelRu}
  data-aria-en={labelEn}
>
  <div class="cast-viewport" data-slider-viewport>
    <ol class="cast-track">
      {
        characters.map((character, index) => {
          const name = pick(character.data.name, 'ru');
          const nameEn = pick(character.data.name, 'en');
          const alternate = character.data.hoverImage ?? character.data.imageAlt ?? character.data.image;
          return (
            <li
              class:list={['cast-slide', index === 0 && 'is-active']}
              data-slide
              data-name-ru={name.text}
              data-name-en={nameEn.text}
            >
              <a href={href(`characters/${character.id}`)}>
                <span class="cast-shadow" aria-hidden="true"></span>
                <span class="cast-figure">
                  <span class="cast-photo cast-photo-main">
                    <CatalogImage
                      src={character.data.image}
                      alt=""
                      sizes="(min-width: 900px) 380px, 42vw"
                      priority={index === 0}
                    />
                  </span>
                  <span class="cast-photo cast-photo-alt">
                    <CatalogImage
                      src={alternate}
                      alt=""
                      sizes="(min-width: 900px) 280px, 30vw"
                    />
                  </span>
                </span>
                <span class="cast-name"><BiText ru={name.text} en={nameEn.text} /></span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </div>
  <div class="cast-controls">
    <button
      type="button"
      class="cast-arrow"
      data-slider-prev
      data-aria-ru={t('ru', 'slider.prev')}
      data-aria-en={t('en', 'slider.prev')}
      aria-label={t('ru', 'slider.prev')}
    >
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M14.5 5 L7.5 12 L14.5 19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
    <button
      type="button"
      class="cast-toggle"
      data-slider-toggle
      aria-pressed="false"
      data-label-pause-ru={t('ru', 'slider.pause')}
      data-label-pause-en={t('en', 'slider.pause')}
      data-label-play-ru={t('ru', 'slider.play')}
      data-label-play-en={t('en', 'slider.play')}
      aria-label={t('ru', 'slider.pause')}
    >
      <svg class="icon-pause" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path fill="currentColor" d="M7 5h3.2v14H7zM13.8 5H17v14h-3.2z"></path>
      </svg>
      <svg class="icon-play" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path fill="currentColor" d="M8 5.5v13l11-6.5z"></path>
      </svg>
    </button>
    <p class="cast-count" aria-hidden="true"><span data-slider-current>01</span> / {total}</p>
    <button
      type="button"
      class="cast-arrow"
      data-slider-next
      data-aria-ru={t('ru', 'slider.next')}
      data-aria-en={t('en', 'slider.next')}
      aria-label={t('ru', 'slider.next')}
    >
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M9.5 5 L16.5 12 L9.5 19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
  <p
    class="visually-hidden"
    data-slider-status
    aria-live="polite"
    data-template-ru={t('ru', 'slider.status')}
    data-template-en={t('en', 'slider.status')}
  >
    {first
      ? t('ru', 'slider.status', {
          name: firstName,
          index: 1,
          total: characters.length,
        })
      : ''}
  </p>
</section>

<script>
  import '../scripts/slider.ts';
</script>
