---
import { pick } from '../i18n';
import type { CharacterEntry, WorkEntry } from '../lib/catalog';
import { href } from '../lib/urls';
import { resolveTags } from '../data/tags';
import CatalogImage from './CatalogImage.astro';
import BiText from './BiText.astro';

interface Props {
  character: CharacterEntry;
  work: WorkEntry;
  level?: 'h2' | 'h3';
  priority?: boolean;
}

const { character, work, level = 'h2', priority = false } = Astro.props;
const name = pick(character.data.name, 'ru');
const nameEn = pick(character.data.name, 'en');
const workTitle = pick(work.data.title, 'ru');
const workTitleEn = pick(work.data.title, 'en');
const tags = resolveTags(character.data.tags, 'ru').slice(0, 3);
const tagsEn = resolveTags(character.data.tags, 'en');
const page = href(`characters/${character.id}`);
const Heading = level;
---

<article class="card">
  <a class="card-link" href={page}>
    <div class="card-media">
      <CatalogImage
        src={character.data.image}
        alt=""
        sizes="(min-width: 1100px) 220px, (min-width: 700px) 30vw, 46vw"
        priority={priority}
      />
    </div>
  </a>
  <div class="card-body">
    <Heading class="card-title"><a href={page}><BiText ru={name.text} en={nameEn.text} /></a></Heading>
    <p class="card-work">
      <a href={href(`works/${work.id}`)}><BiText ru={workTitle.text} en={workTitleEn.text} /></a>
    </p>
    {
      tags.length > 0 && (
        <ul class="chip-row">
          {tags.map((tag, index) => (
            <li>
              <a class="chip" href={href(`tags/${tag.categoryId}/${tag.valueId}`)}>
                <BiText ru={tag.value.text} en={tagsEn[index]?.value.text || tag.value.text} />
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
