---
import { pick } from '../i18n';
import type { CharacterEntry, WorkEntry } from '../lib/catalog';
import { characterFilterHref, href } from '../lib/urls';
import { resolveTags } from '../data/tags';
import CatalogImage from './CatalogImage.astro';
import BiText from './BiText.astro';

interface Props {
  character: CharacterEntry;
  work: WorkEntry;
  level?: 'h2' | 'h3';
  priority?: boolean;
  /** Work title reads like a price line. On a work page, tags read like a material line. */
  detail?: 'work' | 'tags';
}

const { character, work, level = 'h2', priority = false, detail = 'work' } = Astro.props;
const name = pick(character.data.name, 'ru');
const nameEn = pick(character.data.name, 'en');
const workTitle = pick(work.data.title, 'ru');
const workTitleEn = pick(work.data.title, 'en');
const tags = resolveTags(character.data.tags, 'ru');
const tagsEn = resolveTags(character.data.tags, 'en');
const tagLine = tags.map((tag) => tag.value.text).join(' · ');
const tagLineEn = tagsEn.map((tag) => tag.value.text).join(' · ');
const lineRu = detail === 'tags' && tagLine ? tagLine : workTitle.text;
const lineEn = detail === 'tags' && (tagLineEn || tagLine) ? tagLineEn || tagLine : workTitleEn.text;
const hover = character.data.hoverImage ?? character.data.imageAlt;
const page = href(`characters/${character.id}`);
const Heading = level;
---

<article class:list={['tile', hover && 'has-alt']}>
  <a class="tile-link" href={page}>
    <div class="tile-stage">
      <div class="tile-shot tile-shot-main">
        <CatalogImage
          src={character.data.image}
          alt=""
          sizes="(min-width: 1100px) 240px, (min-width: 700px) 30vw, 46vw"
          priority={priority}
        />
      </div>
      {
        hover && (
          <div class="tile-shot tile-shot-alt" aria-hidden="true">
            <CatalogImage
              src={hover}
              alt=""
              sizes="(min-width: 1100px) 240px, (min-width: 700px) 30vw, 46vw"
            />
          </div>
        )
      }
    </div>
    <Heading class="tile-name"><BiText ru={name.text} en={nameEn.text} /></Heading>
    {detail !== 'tags' && <p class="tile-line"><BiText ru={lineRu} en={lineEn} /></p>}
  </a>
  {
    detail === 'tags' && tags.length > 0 && (
      <p class="tile-tags">
        {tags.map((tag, index) => (
          <a href={characterFilterHref(tag.categoryId, tag.valueId)}>
            <BiText ru={tag.value.text} en={tagsEn[index]?.value.text || tag.value.text} />
          </a>
        ))}
      </p>
    )
  }
</article>
