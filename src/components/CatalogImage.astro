---
import { getImage, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  priority?: boolean;
  /** Leave src empty until the slider moves this picture near the center. */
  defer?: boolean;
}

const { src, alt, sizes, priority = false, defer = false } = Astro.props;
// One width, strictly below the master, so a few thousand cards stay cheap to encode.
const target = Math.min(480, Math.max(1, src.width - 1));
const quality = 68;

let deferred:
  | { avif: string; webp: string; width: number; height: number }
  | undefined;
if (defer) {
  const [avif, webp] = await Promise.all([
    getImage({ src, width: target, format: 'avif', quality }),
    getImage({ src, width: target, format: 'webp', quality }),
  ]);
  deferred = {
    avif: avif.src,
    webp: webp.src,
    width: webp.attributes.width ?? target,
    height: webp.attributes.height ?? Math.max(1, Math.round((src.height * target) / src.width)),
  };
}
---

{
  deferred ? (
    <picture data-deferred-picture>
      <source type="image/avif" data-srcset={deferred.avif} />
      <img
        alt={alt}
        data-src={deferred.webp}
        width={deferred.width}
        height={deferred.height}
        decoding="async"
      />
    </picture>
  ) : (
    <Picture
      src={src}
      alt={alt}
      widths={[target]}
      sizes={sizes}
      formats={['avif']}
      fallbackFormat="webp"
      quality={quality}
      priority={priority}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
    />
  )
}
