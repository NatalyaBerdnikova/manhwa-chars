---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  priority?: boolean;
}

const { src, alt, sizes, priority = false } = Astro.props;
// Stay strictly below the master width. A same-size WebP would collide with
// the imported file and Astro's image pipeline would fail the build.
const widths = [360, 540, 720, 960, 1280].filter((width) => width < src.width);
if (widths.length === 0) widths.push(Math.max(1, src.width - 1));
---

<Picture
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  formats={['avif', 'webp']}
  fallbackFormat="png"
  quality={70}
  priority={priority}
/>
