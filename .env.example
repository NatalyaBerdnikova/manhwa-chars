# Origin of the deployed site, without a trailing slash.
# User/organization GitHub Pages: https://username.github.io
# Project Pages: still the origin only — put /repo-name/ in BASE_PATH.
SITE_URL=https://natalyaberdnikova.github.io

# Subpath when the site is not served from the domain root.
BASE_PATH=/manhwa-chars/

# Cloudflare Worker URL that forwards the form to Telegram.
# Leave empty to use formEndpoint from site.config.json.
PUBLIC_FORM_ENDPOINT=

# Optional Cloudflare Turnstile site key. Leave empty to skip the widget.
# The matching secret is set on the worker, not here.
PUBLIC_TURNSTILE_SITE_KEY=
