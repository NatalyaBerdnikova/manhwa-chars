{
  "name": "ink-atlas",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4471",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4471",
    "astro": "astro",
    "check": "astro check",
    "images": "node ./scripts/optimize-images.mjs",
    "images:check": "node ./scripts/optimize-images.mjs --check",
    "placeholders": "node ./scripts/generate-placeholders.mjs",
    "import:mangabuff": "node ./scripts/import-mangabuff.mjs",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "node ./scripts/optimize-images.mjs --staged"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "astro": "^7.4.7",
    "marked": "^18.1.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3"
  }
}
